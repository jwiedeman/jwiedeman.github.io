---
import Layout from '../../../layouts/Layout.astro';

const architectureDiagram = `Phone handset (RJ11)
   │  analog line
   ▼
ATA with an FXS port (for example Grandstream HT801)
   │  SIP call + RTP audio over the local network
   ▼
Raspberry Pi
   ├─ SIP client (pjsua2): answer, hang up, send and receive audio
   ├─ Speech-to-text (Vosk or Whisper.cpp)
   ├─ Rule engine: match the transcript against rules.yaml
   │     ├─ match    → play an MP3, move to the next state
   │     └─ no match → play a fallback MP3, retry, then escalate
   └─ Audio player: send the MP3 audio back into the call`;

const yamlSchema = `<span class="comment"># rules.yaml - Phone Agent Configuration</span>

<span class="keyword">states:</span>
  <span class="keyword">greeting:</span>
    <span class="keyword">triggers:</span>
      - <span class="string">"hello"</span>
      - <span class="string">"hi"</span>
      - <span class="string">"hey"</span>
      - <span class="keyword">regex:</span> <span class="string">"good (morning|afternoon|evening)"</span>
    <span class="keyword">action:</span>
      <span class="keyword">play:</span> <span class="string">"greetings/welcome.mp3"</span>
      <span class="keyword">next:</span> <span class="string">"main_menu"</span>

  <span class="keyword">main_menu:</span>
    <span class="keyword">triggers:</span>
      - <span class="keyword">match:</span> <span class="string">"hours|open|time"</span>
        <span class="keyword">action:</span>
          <span class="keyword">play:</span> <span class="string">"info/hours.mp3"</span>
          <span class="keyword">next:</span> <span class="string">"anything_else"</span>
      - <span class="keyword">match:</span> <span class="string">"location|address|where"</span>
        <span class="keyword">action:</span>
          <span class="keyword">play:</span> <span class="string">"info/location.mp3"</span>
          <span class="keyword">next:</span> <span class="string">"anything_else"</span>
      - <span class="keyword">match:</span> <span class="string">"person|human|representative"</span>
        <span class="keyword">action:</span>
          <span class="keyword">play:</span> <span class="string">"transfer/hold.mp3"</span>
          <span class="keyword">escalate:</span> <span class="keyword">true</span>
    <span class="keyword">fallback:</span>
      <span class="keyword">play:</span> <span class="string">"fallback/options.mp3"</span>
      <span class="keyword">retry:</span> <span class="string">2</span>

  <span class="keyword">anything_else:</span>
    <span class="keyword">triggers:</span>
      - <span class="keyword">match:</span> <span class="string">"yes|yeah|more"</span>
        <span class="keyword">action:</span>
          <span class="keyword">next:</span> <span class="string">"main_menu"</span>
      - <span class="keyword">match:</span> <span class="string">"no|done|bye"</span>
        <span class="keyword">action:</span>
          <span class="keyword">play:</span> <span class="string">"greetings/goodbye.mp3"</span>
          <span class="keyword">hangup:</span> <span class="keyword">true</span>`;

const projectFiles = `phone-agent/
├── config/
│   ├── rules.yaml          # Conversation flow rules
│   └── settings.yaml       # System configuration
├── audio/
│   ├── greetings/          # Welcome/goodbye MP3s
│   ├── info/               # Information responses
│   ├── fallback/           # Error/retry prompts
│   └── transfer/           # Hold music, transfer notices
├── src/
│   ├── main.py             # Entry point
│   ├── sip_handler.py      # SIP/RTP management
│   ├── speech.py           # STT/TTS interface
│   ├── rules_engine.py     # State machine + keyword matching
│   ├── audio_player.py     # MP3 playback control
│   └── utils.py            # Helpers
├── tests/
├── requirements.txt
└── README.md`;
---
<Layout title="Phone Agent" description="Design for a Raspberry Pi that answers an analog phone, matches what the caller says against keyword rules, and plays recorded MP3 replies." headingTracker={false}>
  <div class="phone-agent-wrapper">
    <header class="project-header">
      <h1>Phone Agent</h1>
      <p class="subtitle">
        A Raspberry Pi that answers an analog phone, turns the caller's speech into text, matches it against keyword rules,
        and plays recorded MP3 replies.
      </p>
      <p><a href="/lab/ai/">← AI lab</a></p>
    </header>

    <section class="section">
      <p><strong>Design for a build. Not finished, and the code is not published.</strong></p>
    </section>

    <section class="section">
      <h2>How the parts connect</h2>
      <pre class="architecture" set:html={architectureDiagram}></pre>
    </section>

    <section class="section">
      <h2>Parts</h2>
      <div class="components-grid">
        <div class="component-card">
          <h3>Phone interface</h3>
          <p>An ATA (analog telephone adapter) with an FXS port turns the analog phone into a SIP endpoint.</p>
          <ul>
            <li>Detects off-hook and rings the phone</li>
            <li>Detects keypad (DTMF) tones</li>
            <li>Sends call audio to the Pi over SIP/RTP</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>Speech-to-text</h3>
          <p>Runs on the Pi, with no cloud service.</p>
          <ul>
            <li>Vosk for streaming recognition</li>
            <li>Optional custom vocabulary for expected words</li>
            <li>Voice activity detection to find the end of a sentence</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>Rule engine</h3>
          <p>A state machine. Each state has keyword or regex triggers and an action.</p>
          <ul>
            <li>Keyword, regex, and fuzzy matching</li>
            <li>Tracks the current state of the call</li>
            <li>Falls back and retries when nothing matches</li>
            <li>Optional: pick at random between several recordings for the same reply</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>MP3 playback</h3>
          <p>Replies are pre-recorded, so they always sound the same.</p>
          <ul>
            <li>Folder of MP3 files per topic</li>
            <li>Play several files in a row</li>
            <li>Normalize volume</li>
            <li>Stop playback when the caller starts talking (barge-in)</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Rules</h2>
      <p>
        Each rule pairs trigger words with an action. When the caller's words match a trigger, the action runs:
        play an MP3, move to another state, escalate, or hang up.
      </p>

      <div class="rule-example">
        <div class="trigger">TRIGGER: "hello" | "hi" | "hey" | "good morning"</div>
        <div class="action">ACTION: play("greetings/welcome.mp3") → next("main_menu")</div>
      </div>

      <div class="rule-example">
        <div class="trigger">TRIGGER: "hours" | "open" | "time"</div>
        <div class="action">ACTION: play("info/hours.mp3") → next("anything_else")</div>
      </div>

      <div class="rule-example">
        <div class="trigger">TRIGGER: "person" | "human" | "representative"</div>
        <div class="action">ACTION: play("transfer/hold.mp3") → escalate()</div>
      </div>

      <div class="rule-example">
        <div class="trigger">TRIGGER: no match or timeout</div>
        <div class="action">ACTION: play("fallback/options.mp3") → retry up to 2 times</div>
      </div>

      <h3 style="margin-top: 24px; font-size: 12px; color: var(--fg-strong); text-transform: uppercase; letter-spacing: 0.04em;">Rule file (YAML)</h3>
      <pre class="code-block" set:html={yamlSchema}></pre>
    </section>

    <section class="section">
      <h2>Hardware</h2>
      <ul class="hardware-list">
        <li>
          <span class="item">Raspberry Pi 4 (4 GB or more)</span>
          <span class="note">Assumed enough for Vosk small models; not yet tested</span>
        </li>
        <li>
          <span class="item">Grandstream HT801 ATA</span>
          <span class="note">FXS port for the phone, SIP to the Pi</span>
        </li>
        <li>
          <span class="item">USB sound card</span>
          <span class="note">Optional; only needed if audio is not routed over SIP</span>
        </li>
        <li>
          <span class="item">Analog phone</span>
          <span class="note">Any standard RJ11 phone</span>
        </li>
        <li>
          <span class="item">microSD card (32 GB or more)</span>
          <span class="note">OS and audio files</span>
        </li>
        <li>
          <span class="item">Power supplies</span>
          <span class="note">5 V 3 A for the Pi; the ATA uses its own adapter</span>
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>Software</h2>
      <div class="components-grid">
        <div class="component-card">
          <h3>Runtime</h3>
          <ul>
            <li>Python 3.11+</li>
            <li>asyncio</li>
            <li>pjsua2 for SIP/RTP</li>
            <li>PyAudio for local audio I/O</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>Speech</h3>
          <ul>
            <li>Vosk (offline speech-to-text)</li>
            <li>pyttsx3 or espeak (text-to-speech fallback)</li>
            <li>webrtcvad (voice activity detection)</li>
            <li>soundfile (audio file reading)</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>Rule engine</h3>
          <ul>
            <li>PyYAML (rule file)</li>
            <li>re (regex matching)</li>
            <li>transitions (state machine)</li>
            <li>rapidfuzz (fuzzy matching)</li>
          </ul>
        </div>

        <div class="component-card">
          <h3>Optional</h3>
          <ul>
            <li>Ollama (local LLM when no rule matches)</li>
            <li>Whisper.cpp (more accurate speech-to-text)</li>
            <li>Piper (more natural text-to-speech)</li>
            <li>SQLite (call log)</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Open questions</h2>
      <ul>
        <li>Where does "escalate" send the call on a single home line? Options: ring another SIP phone, or play a message and hang up.</li>
        <li>Is Vosk accurate enough on narrowband phone audio (8 kHz)?</li>
        <li>How long is the delay between the caller stopping and the reply starting?</li>
      </ul>
    </section>

    <section class="section">
      <h2>Planned file layout</h2>
      <pre class="code-block" set:html={projectFiles}></pre>
    </section>
  </div>
</Layout>

<style is:global>
  .phone-agent-wrapper {
    --border: var(--color-rule);
    --fg: var(--color-text);
    --fg-strong: var(--color-text);
    --muted: var(--color-muted);
    --accent: var(--color-accent);
    --bg: var(--color-bg);
    --bg-subtle: var(--surface-tint);
    --bg-panel: var(--surface-panel);
    --bg-raised: var(--surface-raised);
  }

    .phone-agent-wrapper {
      padding: var(--space-3) var(--page-inline);
      max-width: var(--site-max);
      margin: 0 auto;
    }

    .project-header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }

    .project-header h1 {
      font-size: 32px;
      font-weight: 700;
      color: var(--fg-strong);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .project-header .subtitle {
      font-size: 14px;
      color: var(--muted);
      max-width: 600px;
    }

    .section {
      margin-bottom: 48px;
    }

    .section h2 {
      font-size: 14px;
      font-weight: 600;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .section p {
      color: var(--fg);
      line-height: 1.7;
      margin-bottom: 16px;
    }

    .architecture {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      padding: 24px;
      /* IBM Plex Mono lacks box-drawing glyphs; use a face that has them so columns align */
      font-family: 'Cascadia Mono', Consolas, Menlo, 'DejaVu Sans Mono', monospace;
      font-size: 12px;
      line-height: 1.25;
      overflow-x: auto;
      white-space: pre;
      color: var(--fg);
    }

    .components-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
    }

    .component-card {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      padding: 20px;
    }

    .component-card h3 {
      font-size: 13px;
      font-weight: 600;
      color: var(--fg-strong);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 12px;
    }

    .component-card p {
      font-size: 13px;
      color: var(--fg);
      margin-bottom: 12px;
    }

    .component-card ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .component-card li {
      font-size: 12px;
      color: var(--muted);
      padding: 4px 0;
      border-top: 1px solid var(--border);
    }

    .component-card li:first-child {
      border-top: none;
    }

    .code-block {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      padding: 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      overflow-x: auto;
      color: var(--fg);
    }

    .code-block .comment {
      color: var(--muted);
    }

    .code-block .keyword {
      color: var(--accent);
    }

    .code-block .string {
      color: #5a7d9a;
    }

    .rule-example {
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      padding: 16px;
      margin-bottom: 16px;
    }

    .rule-example .trigger {
      font-size: 12px;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .rule-example .action {
      font-size: 12px;
      color: var(--fg);
    }

    .hardware-list {
      list-style: none;
      padding: 0;
    }

    .hardware-list li {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    .hardware-list .item {
      color: var(--fg-strong);
    }

    .hardware-list .note {
      color: var(--muted);
      font-size: 12px;
    }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      background: var(--bg-raised);
      border: 1px solid var(--border);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }

    .status-badge.active {
      border-color: var(--accent);
      color: var(--accent);
    }
  </style>
