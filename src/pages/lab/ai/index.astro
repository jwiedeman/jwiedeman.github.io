---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import IndexList from '../../../components/IndexList.astro';

const entries = [
  {
    title: 'Mini Digits Generator',
    href: '/lab/ai/mini-digits-gan/',
    description: 'Blends ten font-drawn digits into 28×28 images from a random seed. Hand-set weights, not a trained GAN.',
    kind: 'Demo',
  },
  {
    title: 'Color Pattern Generator',
    href: '/lab/ai/chromatic-orbit-gan/',
    description: 'Mixes six math-defined color patterns into 64×64 images from a random seed. Hand-set weights, not a trained GAN.',
    kind: 'Demo',
  },
  {
    title: 'NeuralGo',
    href: '/lab/ai/neural-go/',
    description: 'Two small networks play 9×9 Go against each other with one-move lookahead and learn to predict the winner.',
    kind: 'Demo',
  },
  {
    title: 'Pattern Match Learner',
    href: '/lab/ai/pattern-match-learner/',
    description: 'A small network learns to sort 8×8 pixel patterns into six types with gradient descent.',
    kind: 'Demo',
  },
  {
    title: 'Phone Agent',
    href: '/lab/ai/phone-agent/',
    description: 'Design for a Raspberry Pi that answers an analog phone and plays MP3 replies based on keyword rules.',
    kind: 'Design',
  },
  {
    title: 'Mushroom Forecasting',
    href: '/lab/ai/mushroom-forecasting-alerts/',
    description: 'Concept: estimate when and where mushrooms fruit from weather and past sightings.',
    kind: 'Concept',
  },
  {
    title: 'Mycology Classification',
    href: '/lab/ai/mycology-classification/',
    description: 'Concept: suggest likely fungus species from a photo, with safety limits.',
    kind: 'Concept',
  },
  {
    title: 'Call Triage Agent',
    href: '/lab/ai/call-triage-agent/',
    description: 'Concept: a voice assistant that answers calls, handles routine requests, and transfers the rest.',
    kind: 'Concept',
  },
  {
    title: 'Demo Arcade Intelligence',
    href: '/lab/ai/demo-arcade-intelligence/',
    description: 'Concept: people play simple arcade games against reinforcement learning agents.',
    kind: 'Concept',
  },
].map((e, i) => ({ ...e, id: String(i + 1).padStart(2, '0') }));
---
<Layout title="AI" description="Small machine learning demos that run in the browser, plus design notes for projects not yet built." headingTracker={false}>
  <div class="container">
    <PageHeader title="AI" dept="Lab" meta={[`${entries.length} entries`]} />
    <IndexList entries={entries} />
  </div>
</Layout>
