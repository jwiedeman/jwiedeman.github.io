---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/analytics-sandbox.css';
---
<Layout title="Adobe Analytics Sandbox">
  <div class="analytics-sandbox adobe-sandbox">
    <header class="sandbox-header hairline-bottom">
      <p class="supertitle mono">Analytics Lab / Instrumentation</p>
      <h1>Adobe Analytics sandbox</h1>
      <p class="intro">
        AppMeasurement sends two kinds of server calls. <code>s.t()</code> records a page view.
        <code>s.tl()</code> records a link or custom interaction without counting a page view. Use the controls
        below to see the call each interaction makes. The console shows a simulated beacon; nothing is sent.
      </p>
      <dl class="sandbox-meta">
        <div>
          <dt>Report suite</dt>
          <dd class="mono">jwiedeman.sandbox</dd>
        </div>
        <div>
          <dt>Endpoint</dt>
          <dd class="mono">https://metrics-demo.sc.omtrdc.net/b/ss/.../s</dd>
        </div>
      </dl>
    </header>

    <nav class="sandbox-outline" aria-label="Interaction index">
      <h2 class="sandbox-outline__title">Interaction index</h2>
      <ol class="sandbox-outline__list">
        <li><a href="#adobe-cta-card">Custom link: demo request</a></li>
        <li><a href="#adobe-link-card">Download link: pricing PDF</a></li>
        <li><a href="#adobe-form-card">Custom link: newsletter sign-up</a></li>
        <li><a href="#adobe-cart-card">Commerce: add to cart</a></li>
        <li><a href="#adobe-pageview-card">Page view variables</a></li>
        <li><a href="#adobe-reference-card">Variable reference</a></li>
      </ol>
    </nav>

    <div class="sandbox-grid">
      <section class="sandbox-panel">
        <article id="adobe-cta-card" class="sandbox-card adobe-card" aria-labelledby="adobe-cta-title">
          <header>
            <p id="adobe-cta-title" class="sandbox-card__tag mono">linkName: cta:request-demo · linkType: o</p>
            <h3>Custom link: demo request</h3>
          </header>
          <p>
            A button click tracked with <code>s.tl()</code> and link type <code>o</code> (custom link).
            <code>linkTrackVars</code> and <code>linkTrackEvents</code> list the variables and events the call
            may send. Anything not listed is dropped.
          </p>
          <dl class="sandbox-card__meta">
            <div>
              <dt>events</dt>
              <dd class="mono">event5</dd>
            </div>
            <div>
              <dt>prop4</dt>
              <dd class="mono">cta:request-demo</dd>
            </div>
            <div>
              <dt>eVar4</dt>
              <dd class="mono">Request a demo</dd>
            </div>
            <div>
              <dt>contextData</dt>
              <dd class="mono">component=pricing-page · priority=primary</dd>
            </div>
          </dl>
          <button
            id="aa-primary-cta"
            class="sandbox-action"
            data-aa-component="pricing-page"
            data-aa-role="primary-cta"
            type="button"
          >
            Request a demo
          </button>
          <pre class="adobe-code mono">{`s.tl(this, 'o', 'cta:request-demo', {
  linkTrackVars: 'events,prop4,eVar4,contextData.component,contextData.priority',
  linkTrackEvents: 'event5',
  events: 'event5',
  prop4: 'cta:request-demo',
  eVar4: 'Request a demo',
  contextData: { component: 'pricing-page', priority: 'primary' }
});`}</pre>
        </article>

        <article id="adobe-link-card" class="sandbox-card adobe-card" aria-labelledby="adobe-link-title">
          <header>
            <p id="adobe-link-title" class="sandbox-card__tag mono">linkName: download:pricing-pdf · linkType: d</p>
            <h3>Download link: pricing PDF</h3>
          </header>
          <p>
            Link type <code>d</code> reports the click as a file download. Type <code>e</code> is used for exit
            links. AppMeasurement can track both automatically with <code>trackDownloadLinks</code> and
            <code>trackExternalLinks</code>; the explicit call below adds custom variables.
          </p>
          <dl class="sandbox-card__meta">
            <div>
              <dt>events</dt>
              <dd class="mono">event8</dd>
            </div>
            <div>
              <dt>prop6</dt>
              <dd class="mono">download:pricing-pdf</dd>
            </div>
            <div>
              <dt>eVar6</dt>
              <dd class="mono">Pricing PDF</dd>
            </div>
            <div>
              <dt>contextData</dt>
              <dd class="mono">component=pricing-page · file=pricing.pdf</dd>
            </div>
          </dl>
          <a
            id="aa-secondary-link"
            class="sandbox-link"
            href="#"
            data-aa-component="pricing-page"
            data-aa-role="download-link"
          >
            Download pricing PDF
          </a>
          <pre class="adobe-code mono">{`s.tl(this, 'd', 'download:pricing-pdf', {
  linkTrackVars: 'events,prop6,eVar6,contextData.component,contextData.file',
  linkTrackEvents: 'event8',
  events: 'event8',
  prop6: 'download:pricing-pdf',
  eVar6: 'Pricing PDF',
  contextData: { component: 'pricing-page', file: 'pricing.pdf' }
});`}</pre>
        </article>

        <article id="adobe-form-card" class="sandbox-card adobe-card" aria-labelledby="adobe-form-title">
          <header>
            <p id="adobe-form-title" class="sandbox-card__tag mono">linkName: form:newsletter-signup · linkType: o</p>
            <h3>Custom link: newsletter sign-up</h3>
          </header>
          <p>
            A form submission tracked as a custom link. The selected topic is sent in eVar9. Submission is
            blocked in this demo so you can read the payload.
          </p>
          <dl class="sandbox-card__meta">
            <div>
              <dt>events</dt>
              <dd class="mono">event12</dd>
            </div>
            <div>
              <dt>prop9</dt>
              <dd class="mono">form:newsletter</dd>
            </div>
            <div>
              <dt>eVar9</dt>
              <dd class="mono">Newsletter topic (form value)</dd>
            </div>
            <div>
              <dt>contextData</dt>
              <dd class="mono">component=newsletter · submission=form</dd>
            </div>
          </dl>
          <form
            id="aa-newsletter-form"
            class="sandbox-form"
            data-aa-component="newsletter"
            data-aa-role="form"
          >
            <label for="aa-newsletter-email">Work email</label>
            <input id="aa-newsletter-email" name="email" type="email" placeholder="name@example.com" required />
            <label for="aa-newsletter-topic">Topic</label>
            <select id="aa-newsletter-topic" name="topic">
              <option value="product-updates">Product updates</option>
              <option value="webinars">Webinars</option>
              <option value="engineering">Engineering blog</option>
            </select>
            <button class="sandbox-action" type="submit">Sign up</button>
          </form>
          <pre class="adobe-code mono">{`s.tl(this, 'o', 'form:newsletter-signup', {
  linkTrackVars: 'events,prop9,eVar9,contextData.component,contextData.submission',
  linkTrackEvents: 'event12',
  events: 'event12',
  prop9: 'form:newsletter',
  eVar9: topic, // e.g. 'product-updates'
  contextData: { component: 'newsletter', submission: 'form' }
});`}</pre>
        </article>

        <article id="adobe-cart-card" class="sandbox-card adobe-card" aria-labelledby="adobe-cart-title">
          <header>
            <p id="adobe-cart-title" class="sandbox-card__tag mono">linkName: cart:add · linkType: o</p>
            <h3>Commerce: add to cart</h3>
          </header>
          <p>
            Commerce events use the reserved names <code>prodView</code>, <code>scOpen</code>,
            <code>scAdd</code>, <code>scRemove</code>, <code>scCheckout</code> and <code>purchase</code>.
            <code>s.products</code> is a comma-separated list of products in the form
            <code>category;product;quantity;price;events;eVars</code>. Quantity and price are only counted on
            <code>purchase</code>.
          </p>
          <dl class="sandbox-card__meta">
            <div>
              <dt>events</dt>
              <dd class="mono">scAdd</dd>
            </div>
            <div>
              <dt>products</dt>
              <dd class="mono">Plans;pro-annual</dd>
            </div>
          </dl>
          <button
            id="aa-add-to-cart"
            class="sandbox-action"
            data-aa-component="product-page"
            data-aa-role="add-to-cart"
            type="button"
          >
            Add Pro plan to cart
          </button>
          <pre class="adobe-code mono">{`s.tl(this, 'o', 'cart:add', {
  linkTrackVars: 'events,products',
  linkTrackEvents: 'scAdd',
  events: 'scAdd',
  products: 'Plans;pro-annual'
});

// On the order confirmation page (s.t()):
s.events = 'purchase';
s.purchaseID = 'ORD-10042';
s.products = 'Plans;pro-annual;1;199.00';`}</pre>
        </article>

        <section id="adobe-pageview-card" class="sandbox-card adobe-card adobe-pageview" aria-labelledby="adobe-pageview-title">
          <h2 id="adobe-pageview-title">Page view variables</h2>
          <p>
            The <code>s.t()</code> call on page load sends every variable that is set on the <code>s</code>
            object. Props hold values for the current hit only. eVars persist according to their expiration
            setting, so later conversions can be credited to them.
          </p>
          <ul class="sandbox-list mono">
            <li>pageName = lab:analytics:adobe-analytics</li>
            <li>channel = lab</li>
            <li>eVar1 = Adobe Analytics Sandbox</li>
            <li>prop1 = lab:analytics</li>
            <li>events = event1</li>
            <li>contextData.page.section = analytics</li>
            <li>contextData.page.template = sandbox</li>
          </ul>
          <pre class="adobe-code mono">{`s.pageName = 'lab:analytics:adobe-analytics';
s.channel = 'lab';
s.prop1 = 'lab:analytics';
s.eVar1 = 'Adobe Analytics Sandbox';
s.events = 'event1';
s.contextData['page.section'] = 'analytics';
s.contextData['page.template'] = 'sandbox';
s.t();`}</pre>
        </section>

        <section id="adobe-reference-card" class="sandbox-card adobe-card" aria-labelledby="adobe-reference-title">
          <h2 id="adobe-reference-title">Variable reference</h2>
          <ul class="sandbox-list">
            <li><code>propN</code>: traffic variable. Hit-scoped, used for pathing and counts.</li>
            <li><code>eVarN</code>: conversion variable. Persists until it expires; success events are credited to it.</li>
            <li><code>eventN</code>: custom success event. Counter by default; can be numeric or currency.</li>
            <li><code>contextData</code>: key/value pairs mapped to props and eVars with processing rules.</li>
            <li><code>s.tl(this, type, name)</code>: link call. <code>o</code> custom, <code>d</code> download, <code>e</code> exit.</li>
          </ul>
          <p>
            With the Web SDK (alloy.js) the same data is sent as XDM. Page views and link clicks are both
            <code>sendEvent</code> calls, distinguished by <code>eventType</code> and
            <code>web.webInteraction</code>.
          </p>
          <pre class="adobe-code mono">{`alloy('sendEvent', {
  xdm: {
    eventType: 'web.webinteraction.linkClicks',
    web: { webInteraction: { name: 'cta:request-demo', type: 'other', linkClicks: { value: 1 } } },
    _experience: { analytics: {
      customDimensions: { eVars: { eVar4: 'Request a demo' }, props: { prop4: 'cta:request-demo' } },
      event1to100: { event5: { value: 1 } }
    } }
  }
});`}</pre>
        </section>
      </section>

      <aside class="sandbox-console adobe-console" data-console-panel aria-labelledby="adobe-console-heading">
        <h2 id="adobe-console-heading">Beacon payloads</h2>
        <p>
          Simulated requests to <code class="mono">https://metrics-demo.sc.omtrdc.net/b/ss/jwiedeman.sandbox/1/JS-2.23.0/s</code>.
          Each entry shows the query string and the same data as JSON. Variable names are shown in their
          AppMeasurement form; a real beacon abbreviates them (<code>eVar4</code> is <code>v4</code>,
          <code>prop4</code> is <code>c4</code>).
        </p>
        <div class="sandbox-console__toolbar" role="group" aria-label="Adobe Analytics console controls">
          <button type="button" class="console-control" data-console-scroll disabled>Jump to latest</button>
          <button type="button" class="console-control" data-console-clear disabled>Clear console</button>
        </div>
        <div
          class="console-stream"
          data-console-stream
          role="log"
          aria-live="polite"
          aria-relevant="additions"
          tabindex="0"
        >
          <p class="console-empty" data-console-empty>No server calls yet.</p>
        </div>
        <noscript>
          <p class="console-empty">Enable JavaScript to see the simulated server calls.</p>
        </noscript>
      </aside>
    </div>
  </div>

  <script type="module">
    const endpoint = 'https://metrics-demo.sc.omtrdc.net/b/ss/jwiedeman.sandbox/1/JS-2.23.0/s';
    const MAX_ENTRIES = 8;

    function createSandboxConsole({ limit = MAX_ENTRIES } = {}) {
      const panel = document.querySelector('[data-console-panel]');
      const stream = panel ? panel.querySelector('[data-console-stream]') : null;
      const empty = stream ? stream.querySelector('[data-console-empty]') : null;
      const clearButton = panel ? panel.querySelector('[data-console-clear]') : null;
      const scrollButton = panel ? panel.querySelector('[data-console-scroll]') : null;

      if (!panel || !stream) {
        return null;
      }

      const hideEmpty = () => {
        if (empty) {
          empty.hidden = true;
        }
      };

      const showEmpty = () => {
        if (empty) {
          empty.hidden = false;
        }
      };

      const updateControls = () => {
        const hasEntries = !!stream.querySelector('.console-entry');
        if (clearButton) {
          clearButton.disabled = !hasEntries;
        }
        if (scrollButton) {
          scrollButton.disabled = !hasEntries;
        }
      };

      const focusPanel = () => {
        const rect = panel.getBoundingClientRect();
        const fullyVisible = rect.top >= 0 && rect.bottom <= window.innerHeight;
        if (!fullyVisible) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          stream.querySelectorAll('.console-entry').forEach((entry) => entry.remove());
          showEmpty();
          updateControls();
          if (typeof stream.scrollTo === 'function') {
            stream.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            stream.scrollTop = 0;
          }
          if (typeof stream.focus === 'function') {
            stream.focus();
          }
        });
      }

      if (scrollButton) {
        scrollButton.addEventListener('click', () => {
          focusPanel();
          if (typeof stream.scrollTo === 'function') {
            stream.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            stream.scrollTop = 0;
          }
        });
      }

      updateControls();

      return {
        append(entry) {
          hideEmpty();
          entry.classList.add('console-entry--recent');
          entry.addEventListener(
            'animationend',
            () => entry.classList.remove('console-entry--recent'),
            { once: true }
          );
          stream.prepend(entry);
          const entries = Array.from(stream.querySelectorAll('.console-entry'));
          if (limit && entries.length > limit) {
            entries.slice(limit).forEach((oldEntry) => oldEntry.remove());
          }
          updateControls();
          if (typeof stream.scrollTo === 'function') {
            stream.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            stream.scrollTop = 0;
          }
          focusPanel();
        }
      };
    }

    const consoleUI = createSandboxConsole({ limit: MAX_ENTRIES });

    // linkType 't' is a page view (s.t()); 'o', 'd' and 'e' are link calls (s.tl()).
    const buildPayload = (linkName, linkType, attributes) => {
      const isPageView = linkType === 't';
      const query = new URLSearchParams({
        AQB: '1',
        ...(isPageView ? {} : { pe: `lnk_${linkType}`, pev2: linkName }),
        ...attributes,
        AQE: '1'
      });

      return {
        method: 'GET',
        summary: isPageView ? `s.t() · ${attributes.pageName}` : `s.tl() · ${linkType} · ${linkName}`,
        request: `${endpoint}?${query.toString()}`,
        data: isPageView
          ? { call: 's.t()', ...attributes }
          : { call: 's.tl()', linkName, linkType, ...attributes }
      };
    };

    const logPayload = (payload) => {
      if (!consoleUI) {
        return;
      }
      const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false });
      const entry = document.createElement('article');
      entry.className = 'console-entry';
      entry.innerHTML = `
        <header class="console-entry__meta">
          <span class="console-entry__method">${payload.method}</span>
          <span>${payload.summary}</span>
          <span>${timestamp}</span>
        </header>
        <pre class="console-entry__body">${payload.request}</pre>
        <pre class="console-entry__body">${JSON.stringify(payload.data, null, 2)}</pre>
      `;
      consoleUI.append(entry);
    };

    const fireLinkTracking = (linkName, linkType, attributes) => {
      const payload = buildPayload(linkName, linkType, attributes);
      logPayload(payload);
    };

    const bindingMap = {
      cta: {
        linkName: 'cta:request-demo',
        linkType: 'o',
        attributes: {
          events: 'event5',
          prop4: 'cta:request-demo',
          eVar4: 'Request a demo',
          'contextData.component': 'pricing-page',
          'contextData.priority': 'primary'
        }
      },
      download: {
        linkName: 'download:pricing-pdf',
        linkType: 'd',
        attributes: {
          events: 'event8',
          prop6: 'download:pricing-pdf',
          eVar6: 'Pricing PDF',
          'contextData.component': 'pricing-page',
          'contextData.file': 'pricing.pdf'
        }
      },
      form: {
        linkName: 'form:newsletter-signup',
        linkType: 'o',
        attributes: {
          events: 'event12',
          prop9: 'form:newsletter',
          'contextData.component': 'newsletter',
          'contextData.submission': 'form'
        }
      },
      cart: {
        linkName: 'cart:add',
        linkType: 'o',
        attributes: {
          events: 'scAdd',
          products: 'Plans;pro-annual'
        }
      }
    };

    const primaryCta = document.getElementById('aa-primary-cta');
    if (primaryCta) {
      primaryCta.addEventListener('click', () => {
        fireLinkTracking(bindingMap.cta.linkName, bindingMap.cta.linkType, bindingMap.cta.attributes);
      });
    }

    const downloadLink = document.getElementById('aa-secondary-link');
    if (downloadLink) {
      downloadLink.addEventListener('click', (event) => {
        event.preventDefault();
        fireLinkTracking(bindingMap.download.linkName, bindingMap.download.linkType, bindingMap.download.attributes);
      });
    }

    const newsletterForm = document.getElementById('aa-newsletter-form');
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const topic = new FormData(event.currentTarget).get('topic') || '';
        fireLinkTracking(bindingMap.form.linkName, bindingMap.form.linkType, {
          ...bindingMap.form.attributes,
          eVar9: String(topic)
        });
        event.currentTarget.reset();
      });
    }

    const addToCart = document.getElementById('aa-add-to-cart');
    if (addToCart) {
      addToCart.addEventListener('click', () => {
        fireLinkTracking(bindingMap.cart.linkName, bindingMap.cart.linkType, bindingMap.cart.attributes);
      });
    }

    const pageViewPayload = buildPayload(null, 't', {
      events: 'event1',
      pageName: 'lab:analytics:adobe-analytics',
      channel: 'lab',
      prop1: 'lab:analytics',
      eVar1: 'Adobe Analytics Sandbox',
      'contextData.page.section': 'analytics',
      'contextData.page.template': 'sandbox'
    });
    logPayload(pageViewPayload);
  </script>

  <style>
    .adobe-sandbox .adobe-card pre.adobe-code {
      margin: 0;
      padding: var(--space-2);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-2);
      background: rgba(0, 0, 0, 0.04);
      overflow-x: auto;
      font-size: var(--text-12);
      line-height: 1.4;
    }

    .adobe-sandbox .adobe-console {
      gap: var(--space-2);
    }
  </style>
</Layout>
