---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/analytics-sandbox.css';
---
<Layout title="X Pixel Sandbox">
  <div class="analytics-sandbox x-sandbox">
    <header class="sandbox-header hairline-bottom">
      <p class="supertitle mono">Analytics Lab / Instrumentation</p>
      <h1>X Pixel Sandbox</h1>
      <p class="intro">
        Example X (Twitter) Pixel calls attached to common page elements. The X Pixel does not use event
        names in code. Each conversion event is created in X Ads Manager, which assigns it an event ID of the
        form <code>tw-&lt;pixel id&gt;-&lt;event id&gt;</code>. The page fires that ID with
        <code>twq('event', ...)</code>. The console on the right shows each call and its parameters.
      </p>
      <dl class="sandbox-meta">
        <div>
          <dt>Pixel ID</dt>
          <dd class="mono">abc12</dd>
        </div>
        <div>
          <dt>Browser endpoints</dt>
          <dd class="mono">https://analytics.twitter.com/i/adsct, https://t.co/i/adsct</dd>
        </div>
        <div>
          <dt>Conversions API</dt>
          <dd class="mono">https://ads-api.x.com/12/measurement/conversions/&lt;pixel-id&gt;</dd>
        </div>
      </dl>
    </header>

    <div class="sandbox-grid">
      <section class="sandbox-panel">
        <section class="sandbox-card x-map" aria-labelledby="x-map-heading">
          <h2 id="x-map-heading">Tracking plan</h2>
          <p>
            Each element carries a <code>data-twq-event</code> attribute with its event ID and a
            <code>data-twq-parameters</code> attribute with its parameters. The event type (Purchase, Lead and
            so on) is set on the event in Ads Manager, not in code.
          </p>
          <dl class="x-map__list">
            <div>
              <dt>Start free trial</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-trl01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Start trial</code>
              </dd>
            </div>
            <div>
              <dt>Book a demo</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-lde01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Lead</code>
              </dd>
            </div>
            <div>
              <dt>Internal link</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-cus01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Custom</code>
              </dd>
            </div>
            <div>
              <dt>Video start / 50%</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-cus02, tw-abc12-cus03</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Custom</code>
              </dd>
            </div>
            <div>
              <dt>File download</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-dwn01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Download</code>
              </dd>
            </div>
            <div>
              <dt>Add to cart / checkout / purchase</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-atc01, tw-abc12-chk01, tw-abc12-pur01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Add to cart, Checkout initiated, Purchase</code>
              </dd>
            </div>
            <div>
              <dt>Demo request form</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-lde02</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Lead</code>
              </dd>
            </div>
            <div>
              <dt>Newsletter sign-up</dt>
              <dd>
                <span class="label">Event ID</span>
                <code>tw-abc12-sgn01</code>
              </dd>
              <dd>
                <span class="label">Type</span>
                <code>Sign up</code>
              </dd>
            </div>
          </dl>
        </section>

        <section class="sandbox-card x-interactive" aria-labelledby="x-interactive-heading">
          <h2 id="x-interactive-heading">Interactive elements</h2>
          <p>
            Click an element to log its <code>twq('event')</code> call. Supported parameters include
            <code>value</code>, <code>currency</code>, <code>contents</code>, <code>conversion_id</code>,
            <code>description</code>, <code>email_address</code> and <code>phone_number</code>.
          </p>

          <div class="x-interactive__section">
            <h3>Lead events</h3>
            <p class="x-interactive__intro">Trial starts and demo bookings.</p>
            <div class="x-interactive__actions">
              <button
                id="x-button"
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-trl01"
                data-twq-type="Start trial"
                data-twq-parameters='{"value":0,"currency":"USD","contents":[{"content_id":"plan-pro","content_name":"Pro plan"}]}'
              >
                Start free trial
              </button>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-lde01"
                data-twq-type="Lead"
                data-twq-parameters='{"value":0,"currency":"USD","description":"demo_booking"}'
              >
                Book a demo
              </button>
            </div>
          </div>

          <div class="x-interactive__section">
            <h3>Content and navigation</h3>
            <p class="x-interactive__intro">Links, video progress and downloads, mostly used to build audiences.</p>
            <div class="x-interactive__actions">
              <a
                id="x-link"
                class="sandbox-link sandbox-element"
                href="/lab/analytics"
                data-twq-event="tw-abc12-cus01"
                data-twq-type="Custom"
                data-twq-parameters='{"description":"analytics_index_link"}'
              >
                View analytics lab index
              </a>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-cus02"
                data-twq-type="Custom"
                data-twq-parameters='{"description":"video_start","contents":[{"content_id":"vid-overview","content_name":"Product overview"}]}'
              >
                Start product video
              </button>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-cus03"
                data-twq-type="Custom"
                data-twq-parameters='{"description":"video_50_percent","contents":[{"content_id":"vid-overview","content_name":"Product overview"}]}'
              >
                Reach 50% of video
              </button>
              <a
                class="sandbox-link sandbox-element"
                href="#"
                data-twq-event="tw-abc12-dwn01"
                data-twq-type="Download"
                data-twq-parameters='{"description":"pricing-guide.pdf","contents":[{"content_id":"pricing-guide","content_type":"pdf"}]}'
              >
                Download pricing guide (PDF)
              </a>
            </div>
          </div>

          <div class="x-interactive__section">
            <h3>Commerce</h3>
            <p class="x-interactive__intro">
              Add to cart, checkout and purchase. On Purchase, <code>conversion_id</code> carries the order ID
              and is used to deduplicate against the Conversions API.
            </p>
            <div class="x-interactive__actions">
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-atc01"
                data-twq-type="Add to cart"
                data-twq-parameters='{"value":129,"currency":"USD","contents":[{"content_id":"SKU-1042","content_name":"Trail running shoe","content_type":"product","content_price":129,"num_items":1}]}'
              >
                Add running shoe
              </button>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-chk01"
                data-twq-type="Checkout initiated"
                data-twq-parameters='{"value":129,"currency":"USD","contents":[{"content_id":"SKU-1042","content_price":129,"num_items":1}]}'
              >
                Begin checkout
              </button>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-pur01"
                data-twq-type="Purchase"
                data-twq-parameters='{"value":129,"currency":"USD","conversion_id":"ORDER-10023","contents":[{"content_id":"SKU-1042","content_price":129,"num_items":1}]}'
              >
                Complete purchase
              </button>
            </div>
          </div>

          <div class="x-interactive__section">
            <h3>Forms</h3>
            <p class="x-interactive__intro">
              Demo request and newsletter sign-up. To improve matching, pass <code>email_address</code> or
              <code>phone_number</code>. Send them SHA-256 hashed after trimming and lowercasing, or check X's
              current documentation on client-side hashing before sending plain values.
            </p>
            <div class="x-interactive__actions x-interactive__actions--column">
              <form
                id="x-form"
                class="sandbox-form sandbox-element sandbox-element--form"
                data-twq-event="tw-abc12-lde02"
                data-twq-type="Lead"
                data-twq-parameters='{"description":"demo_request_form","email_address":"973dfe463ec85785f5f95af5ba3906eedb2d931c24e69824a89ea65dba4e813b"}'
              >
                <label for="x-company">Company</label>
                <input
                  id="x-company"
                  name="company"
                  type="text"
                  placeholder="Example Co."
                  required
                />
                <label for="x-team-size">Team size</label>
                <select id="x-team-size" name="team_size">
                  <option value="1-10">1-10</option>
                  <option value="11-50">11-50</option>
                  <option value="51+">51+</option>
                </select>
                <button type="submit" class="sandbox-action">Request demo</button>
              </form>
              <button
                class="sandbox-action sandbox-element"
                type="button"
                data-twq-event="tw-abc12-sgn01"
                data-twq-type="Sign up"
                data-twq-parameters='{"description":"newsletter_product_updates","value":0,"currency":"USD"}'
              >
                Sign up for newsletter
              </button>
            </div>
          </div>
        </section>
      </section>

      <aside class="sandbox-console x-console" data-console-panel aria-labelledby="x-console-heading">
        <h2 id="x-console-heading">Event console</h2>
        <p>
          Each entry shows the <code>twq</code> call, the event ID with its Ads Manager type, and the
          parameters passed. Entries are generated locally.
        </p>
        <div class="sandbox-console__toolbar" role="group" aria-label="X pixel console controls">
          <button type="button" class="console-control" data-console-scroll disabled>Jump to latest</button>
          <button type="button" class="console-control" data-console-clear disabled>Clear console</button>
        </div>
        <div
          class="console-stream"
          data-console-stream
          role="log"
          aria-live="polite"
          tabindex="0"
        >
          <p class="console-empty" data-console-empty>No events yet. Interact with any element to log one.</p>
        </div>
      </aside>
    </div>

    <section class="sandbox-snippet" aria-labelledby="x-snippet-heading">
      <h2 id="x-snippet-heading">X Pixel base code</h2>
      <p>
        Place the base code in the document head and call <code>twq('config')</code> with your pixel ID. The
        config call also records the page view. Fire conversion events afterwards with
        <code>twq('event', 'tw-&lt;pixel id&gt;-&lt;event id&gt;', {'{'} ... {'}'})</code>.
      </p>
      <pre class="mono"><code>{`&lt;script&gt;
  !function(e,t,n,s,u,a){
    e.twq||(s=e.twq=function(){
      s.exe ? s.exe.apply(s, arguments) : s.queue.push(arguments);
    }, s.version='1.1', s.queue=[], u=t.createElement(n), u.async=!0,
    u.src='https://static.ads-twitter.com/uwt.js', a=t.getElementsByTagName(n)[0],
    a.parentNode.insertBefore(u,a));
  }(window, document, 'script');
  twq('config', 'abc12');
&lt;/script&gt;`}</code></pre>
    </section>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // The base code's queue, without loading uwt.js: calls are logged here and nothing is sent to X.
      if (!window.twq) {
        const q = function () {
          q.queue.push(arguments);
        };
        q.version = '1.1';
        q.queue = [];
        window.twq = q;
      }

      const baseTwq = window.twq;

      function createSandboxConsole({ limit = 6 } = {}) {
        const panel = document.querySelector('[data-console-panel]');
        const stream = panel ? panel.querySelector('[data-console-stream]') : null;
        const empty = stream ? stream.querySelector('[data-console-empty]') : null;
        const clearButton = panel ? panel.querySelector('[data-console-clear]') : null;
        const scrollButton = panel ? panel.querySelector('[data-console-scroll]') : null;

        if (!panel || !stream) {
          return null;
        }

        const hideEmpty = () => {
          if (empty) {
            empty.hidden = true;
          }
        };

        const showEmpty = () => {
          if (empty) {
            empty.hidden = false;
          }
        };

        const updateControls = () => {
          const hasEntries = !!stream.querySelector('.console-entry');
          if (clearButton) {
            clearButton.disabled = !hasEntries;
          }
          if (scrollButton) {
            scrollButton.disabled = !hasEntries;
          }
        };

        const focusPanel = () => {
          const rect = panel.getBoundingClientRect();
          const fullyVisible = rect.top >= 0 && rect.bottom <= window.innerHeight;
          if (!fullyVisible) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        };

        if (clearButton) {
          clearButton.addEventListener('click', () => {
            stream.querySelectorAll('.console-entry').forEach((entry) => entry.remove());
            showEmpty();
            updateControls();
            if (typeof stream.scrollTo === 'function') {
              stream.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
              stream.scrollTop = 0;
            }
            if (typeof stream.focus === 'function') {
              stream.focus();
            }
          });
        }

        if (scrollButton) {
          scrollButton.addEventListener('click', () => {
            focusPanel();
            if (typeof stream.scrollTo === 'function') {
              stream.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
              stream.scrollTop = 0;
            }
          });
        }

        updateControls();

        return {
          append(entry) {
            hideEmpty();
            entry.classList.add('console-entry--recent');
            entry.addEventListener(
              'animationend',
              () => entry.classList.remove('console-entry--recent'),
              { once: true }
            );
            stream.prepend(entry);
            const entries = Array.from(stream.querySelectorAll('.console-entry'));
            if (limit && entries.length > limit) {
              entries.slice(limit).forEach((oldEntry) => oldEntry.remove());
            }
            updateControls();
            if (typeof stream.scrollTo === 'function') {
              stream.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
              stream.scrollTop = 0;
            }
            focusPanel();
          }
        };
      }

      const consoleUI = createSandboxConsole({ limit: 6 });
      const sandboxElements = document.querySelectorAll('.sandbox-element');
      const pixelId = 'abc12';
      // Event ID -> event type as configured in X Ads Manager, for console labels only.
      const eventTypes = {};
      sandboxElements.forEach((element) => {
        if (element.dataset.twqEvent && element.dataset.twqType) {
          eventTypes[element.dataset.twqEvent] = element.dataset.twqType;
        }
      });

      const createConsoleEntry = (type, name, payload) => {
        if (!consoleUI) return;
        const timestamp = new Date();
        const entry = document.createElement('article');
        entry.className = 'console-entry';
        entry.innerHTML = `
          <header class="console-entry__meta">
            <span class="console-entry__method">${type}</span>
            <span>${eventTypes[name] ? `${name} (${eventTypes[name]})` : name}</span>
            <time datetime="${timestamp.toISOString()}">${timestamp.toLocaleTimeString()}</time>
          </header>
          <pre class="console-entry__body">${JSON.stringify(payload, null, 2)}</pre>
        `;
        consoleUI.append(entry);
      };

      const highlightElement = (element) => {
        element.classList.add('sandbox-element--active');
        window.setTimeout(() => element.classList.remove('sandbox-element--active'), 600);
      };

      const decoratedTwq = function(...args) {
        const [type, name, payload = {}] = args;
        if (type === 'config' || type === 'event') {
          createConsoleEntry(type, name, {
            pixelId,
            timestamp: new Date().toISOString(),
            ...payload
          });
        }
        return baseTwq.apply(this, args);
      };

      Object.assign(decoratedTwq, baseTwq);
      Object.defineProperty(decoratedTwq, 'exe', {
        get() {
          return baseTwq.exe;
        },
        set(value) {
          baseTwq.exe = value;
        }
      });
      window.twq = decoratedTwq;

      twq('config', pixelId);

      const buildPayload = (element) => {
        const { twqParameters } = element.dataset;
        try {
          return twqParameters ? JSON.parse(twqParameters) : {};
        } catch (error) {
          return { note: 'Unable to parse data-twq-parameters value.' };
        }
      };

      sandboxElements.forEach((element) => {
        const eventName = element.dataset.twqEvent;
        if (!eventName) return;

        if (element.tagName === 'FORM') {
          element.addEventListener('submit', (event) => {
            event.preventDefault();
            highlightElement(element);
            twq('event', eventName, buildPayload(element));
          });
          return;
        }

        element.addEventListener('click', (event) => {
          if (element.tagName === 'A') {
            event.preventDefault();
          }
          highlightElement(element);
          twq('event', eventName, buildPayload(element));
        });
      });
    });
  </script>

  <style>
    .x-sandbox .x-map__list {
      margin: 0;
      display: grid;
      gap: var(--space-2);
    }

    .x-sandbox .x-map__list div {
      border-left: 3px solid #7e2522;
      padding-left: var(--space-2);
      display: grid;
      gap: 4px;
    }

    .x-sandbox .x-map__list dt {
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0;
    }

    .x-sandbox .x-map__list dd {
      margin: 0;
      display: flex;
      gap: var(--space-1);
      align-items: baseline;
      font-family: var(--font-mono);
      font-size: var(--text-12);
    }

    .x-sandbox .x-map__list .label {
      color: var(--color-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--text-12);
    }

    .x-sandbox .x-interactive__section {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .x-sandbox .x-interactive__section + .x-interactive__section {
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--rule-alpha-60);
      border-top: 1px solid color-mix(in srgb, var(--color-rule) 60%, transparent);
    }

    .x-sandbox .x-interactive__section h3 {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--text-16);
    }

    .x-sandbox .x-interactive__intro {
      margin: 0;
      color: var(--color-muted);
      max-width: 68ch;
    }

    .x-sandbox .x-interactive__actions {
      display: grid;
      gap: var(--space-2);
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .x-sandbox .x-interactive__actions--column {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .x-sandbox .sandbox-element--form {
      gap: var(--space-2);
    }

    .x-sandbox .sandbox-element--form label {
      font-family: var(--font-mono);
      font-size: var(--text-12);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .x-sandbox .sandbox-element--active {
      box-shadow: 0 0 0 2px rgba(126, 37, 34, 0.25);
      transform: translateY(-2px);
    }
  </style>
</Layout>
