---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndexList from '../../components/IndexList.astro';

const modules = [
  {
    id: 'LAB-01',
    title: 'Artificial Intelligence',
    href: '/lab/ai/',
    description: 'Neural networks, generative models, and in-browser training demos.',
  },
  {
    id: 'LAB-02',
    title: 'Analytics',
    href: '/lab/analytics/',
    description: 'Tag sandboxes, pixel inspectors, and data layer prototypes.',
  },
  {
    id: 'LAB-03',
    title: 'Advertising',
    href: '/lab/ads/',
    description: 'Platform playbooks for campaign structure, tracking, and QA.',
  },
  {
    id: 'LAB-04',
    title: 'Hardware',
    href: '/lab/hardware/',
    description: 'Physical builds, boards, and instruments.',
  },
];
---
<Layout title="Lab" headingTracker={false}>
  <div class="container">
    <PageHeader title="Lab" dept="Research & Development" meta={[`${modules.length} sections`]} />
    <IndexList entries={modules} />
  </div>
</Layout>
