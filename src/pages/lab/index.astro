---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndexList from '../../components/IndexList.astro';

const modules = [
  {
    title: 'Artificial Intelligence',
    href: '/lab/ai/',
    description: 'Neural network demos that run in the browser, and design notes for AI concepts.',
  },
  {
    title: 'Analytics',
    href: '/lab/analytics/',
    description: 'Tracking specs, tag sandboxes, and a mock video player for practicing analytics.',
  },
  {
    title: 'Advertising',
    href: '/lab/ads/',
    description: 'Setup playbooks for each ad platform: structure, tracking, and launch checklists.',
  },
  {
    title: 'Marketing',
    href: '/lab/marketing/',
    description: '200 marketing tactics, each with how it works, how to do it, and what to measure.',
  },
  {
    title: 'Hardware',
    href: '/lab/hardware/',
    description: 'Physical builds. Nothing here yet.',
  },
];
---
<Layout title="Lab" headingTracker={false}>
  <div class="container">
    <PageHeader title="Lab" dept="Demos and reference" meta={[`${modules.length} sections`]} />
    <IndexList entries={modules} />
  </div>
</Layout>
