const pages = import.meta.glob('./*/*.md', { eager: true });
const meta = (dir, slug) => {
  const page = pages[`./${dir}/${slug}.md`];
  if (!page) throw new Error(`Missing marketing page: ${dir}/${slug}`);
  return page.frontmatter;
};

const pad = (n) => String(n).padStart(2, '0');
const sections = modules.map((mod, m) => ({
  ...mod,
  code: `MK-${pad(m + 1)}`,
  entries: mod.slugs.map((slug, i) => ({
    id: `${pad(m + 1)}.${pad(i + 1)}`,
    title: meta(mod.dir, slug).title,
    href: `/lab/marketing/${mod.dir}/${slug}/`,
    description: meta(mod.dir, slug).description,
  })),
}));
const total = sections.reduce((n, s) => n + s.entries.length, 0);
---
<Layout title="Marketing" description={`A catalog of ${total} marketing tactics and techniques, organized by module.`} headingTracker={{ enabled: true, headingsSelector: 'h2', minHeadings: 2 }}>
  <div class="container">
    <PageHeader title="Marketing" dept="Lab / 04" meta={[`${sections.length} modules`, `${total} tactics`]} />
    {sections.map((section) => (
      <section class="mk-module">
        <h2 id={section.dir}><span class="mk-module__code">{section.code}</span> {section.name}</h2>
        <IndexList entries={section.entries} />
      </section>
    ))}
  </div>
</Layout>

<style>
  .mk-module h2 {
    margin-top: var(--space-5);
  }

  .mk-module__code {
    font-size: var(--text-11);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    margin-right: 0.5em;
  }

  .mk-module :global(.index-list) {
    margin-bottom: var(--space-3);
  }
</style>
