---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import IndexList from '../../../components/IndexList.astro';

const entries = [
  { title: 'Google Ads', href: '/lab/ads/google-ads/', description: 'Setup, tracking, and review steps for Search, Performance Max, Demand Gen, and Shopping.' },
  { title: 'Meta Ads', href: '/lab/ads/meta-ads/', description: 'Setup, tracking, and review steps for Facebook and Instagram ads, Advantage+, and the Conversions API.' },
  { title: 'LinkedIn Ads', href: '/lab/ads/linkedin-ads/', description: 'Setup, tracking, and review steps for B2B and account-based campaigns and Lead Gen Forms.' },
  { title: 'Microsoft Advertising', href: '/lab/ads/microsoft-advertising/', description: 'Setup, tracking, and review steps for Bing search, Shopping, and Google Ads import.' },
  { title: 'Amazon Ads', href: '/lab/ads/amazon-ads/', description: 'Setup, tracking, and review steps for Sponsored Products, Brands, Display, and Amazon DSP.' },
  { title: 'TikTok Ads', href: '/lab/ads/tiktok-ads/', description: 'Setup, tracking, and review steps for TikTok ads, Spark Ads, and the Events API.' },
  { title: 'X Ads', href: '/lab/ads/x-ads/', description: 'Setup, tracking, and review steps for X ads, the X Pixel, and brand safety.' },
  { title: 'Reddit Ads', href: '/lab/ads/reddit-ads/', description: 'Setup, tracking, and review steps for community targeting and comment moderation.' },
  { title: 'Pinterest Ads', href: '/lab/ads/pinterest-ads/', description: 'Setup, tracking, and review steps for Pinterest ads, catalogs, and the Conversions API.' },
  { title: 'Snapchat Ads', href: '/lab/ads/snapchat-ads/', description: 'Setup, tracking, and review steps for Snapchat ads, AR Lenses, and the Snap Pixel.' },
].map((e, i) => ({ ...e, kind: 'Playbook', id: String(i + 1).padStart(2, '0') }));
---
<Layout title="Advertising" headingTracker={false}>
  <div class="container">
    <PageHeader title="Advertising" meta={[`${entries.length} playbooks`]} />
    <IndexList entries={entries} />
  </div>
</Layout>
