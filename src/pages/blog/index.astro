---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
}
---
<Layout title="Blog" headingTracker={false}>
  <div class="container">
    <PageHeader title="Blog" dept="Notes & Dispatches" meta={[`${posts.length} ${posts.length === 1 ? 'entry' : 'entries'}`]} />

    {posts.length === 0 ? (
      <div class="empty-state">
        <p class="empty-state__code">NO ENTRIES</p>
        <p>Nothing published yet.</p>
      </div>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="post-row">
              <time class="post-row__date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="post-row__title">{post.data.title}</span>
              <span class="post-row__desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Layout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .post-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.25rem var(--space-2);
    padding: var(--space-2) var(--space-1);
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-text);
  }

  .post-row__date {
    font-size: var(--text-11);
    color: var(--color-muted);
  }

  .post-row__title {
    font-size: var(--text-18);
  }

  .post-row__desc {
    grid-column: 2;
    font-size: var(--text-12);
    color: var(--color-muted);
  }

  .post-row:hover .post-row__date,
  .post-row:hover .post-row__desc {
    color: var(--color-bg);
  }
</style>
