---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <span>&copy; {year} Joshua Franklin Wiedeman</span>
    <span class="site-footer__links">
      <a href="mailto:joshua.f.wiedeman@gmail.com">Email</a>
      <a href="https://github.com/jwiedeman" target="_blank" rel="noopener">GitHub</a>
    </span>
    <span class="site-footer__loc">Hillsboro, OR &mdash; 45.5229&deg; N 122.9898&deg; W</span>
  </div>
</footer>

<style>
  .site-footer {
    margin: auto auto 0;
    max-width: var(--site-max);
    width: 100%;
    padding: 0 var(--page-inline);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) 0 var(--space-3);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-11);
    color: var(--color-muted);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-2);
  }

  .site-footer a {
    color: var(--color-muted);
  }

  .site-footer a:hover {
    color: var(--color-bg);
  }
</style>
