      <text x="44" y="228" class="ga4flow__sub">ids, session, consent</text>
      <text x="44" y="244" class="ga4flow__sub">batch · sendBeacon / fetch</text>
      <text x="272" y="212" class="ga4flow__count" text-anchor="end" data-count="sdk">0</text>
    </g>

    <!-- app -->
    <g class="ga4flow__node" data-stage="app" tabindex="0" role="button" aria-label="Firebase SDK">
      <rect x="32" y="330" width="252" height="96" />
      <text x="44" y="350" class="ga4flow__name">Firebase SDK</text>
      <text x="44" y="368" class="ga4flow__sub">app_instance_id · auto events</text>
      <text x="44" y="384" class="ga4flow__sub">stores events on device</text>
      <text x="44" y="400" class="ga4flow__sub">uploads ~hourly or on background</text>
      <text x="44" y="416" class="ga4flow__sub">stored <tspan class="ga4flow__count" data-count="appq">0</tspan></text>
      <text x="272" y="350" class="ga4flow__count" text-anchor="end" data-count="app">0</text>
    </g>

    <!-- tv / server -->
    <g class="ga4flow__node" data-stage="mp" tabindex="0" role="button" aria-label="Measurement Protocol">
      <rect x="32" y="480" width="252" height="96" />
      <text x="44" y="500" class="ga4flow__name">Measurement Protocol</text>
      <text x="44" y="518" class="ga4flow__sub">Roku, smart TV, console, kiosk</text>
      <text x="44" y="534" class="ga4flow__sub">backend: refunds, renewals</text>
      <text x="44" y="550" class="ga4flow__sub">JSON POST + api_secret</text>
      <text x="44" y="566" class="ga4flow__sub">you supply client_id / user_id</text>
      <text x="272" y="500" class="ga4flow__count" text-anchor="end" data-count="mp">0</text>
    </g>

    <!-- collection -->
    <g class="ga4flow__node ga4flow__node--optional" data-stage="sgtm" tabindex="0" role="button" aria-label="Server-side GTM, optional">
      <rect x="350" y="140" width="170" height="66" />
      <text x="362" y="160" class="ga4flow__name">Server-side GTM</text>
      <text x="362" y="176" class="ga4flow__sub">optional · own domain</text>
      <text x="362" y="192" class="ga4flow__sub">edit + forward hits</text>
      <text x="510" y="192" class="ga4flow__count" text-anchor="end" data-count="sgtm">0</text>
    </g>
    <g class="ga4flow__node" data-stage="collect" tabindex="0" role="button" aria-label="Collection endpoints">
      <rect x="350" y="250" width="190" height="210" />
      <text x="362" y="270" class="ga4flow__name">Collection</text>
      <text x="528" y="270" class="ga4flow__count" text-anchor="end" data-count="collect">0</text>
      <text x="362" y="294" class="ga4flow__sub">web  /g/collect</text>
      <text x="362" y="364" class="ga4flow__sub">app  app-measurement.com/a</text>
      <text x="362" y="434" class="ga4flow__sub">mp   /mp/collect</text>
      <text x="362" y="318" class="ga4flow__note">nearest Google edge</text>
      <text x="362" y="388" class="ga4flow__note">204, no validation</text>
      <text x="362" y="450" class="ga4flow__note">debug: /debug/mp/collect</text>
    </g>

    <!-- property -->
    <g class="ga4flow__node" data-stage="processing" tabindex="0" role="button" aria-label="GA4 property processing">
      <rect x="590" y="110" width="240" height="394" />
      <text x="602" y="132" class="ga4flow__name">Processing</text>
      <text x="602" y="148" class="ga4flow__sub">1 property · web + app streams</text>
      <text x="602" y="440" class="ga4flow__sub">queued</text>
      <text x="818" y="440" class="ga4flow__count" text-anchor="end" data-count="queue">0</text>
      <rect x="602" y="452" width="216" height="6" class="ga4flow__meter" />
      <rect x="602" y="452" width="0" height="6" class="ga4flow__meter-fill" data-meter />
      <text x="602" y="480" class="ga4flow__note">standard reports: within 24–48 h</text>
      <text x="602" y="494" class="ga4flow__note">click a step for detail</text>
    </g>
    {procSteps.map(([key, label], i) => (
      <g class="ga4flow__step" data-stage={key} data-step={i} tabindex="0" role="button" aria-label={label}>
        <rect x="598" y={164 + i * 28} width="224" height="24" />
        <text x="608" y={180 + i * 28} class="ga4flow__step-text">{label}</text>
      </g>
    ))}
    <g class="ga4flow__node" data-stage="import" tabindex="0" role="button" aria-label="Data import and product links">
      <rect x="590" y="534" width="240" height="56" />
      <text x="602" y="554" class="ga4flow__name">Data import · links</text>
      <text x="602" y="570" class="ga4flow__sub">cost, CRM, offline events</text>
      <text x="602" y="584" class="ga4flow__sub">Google Ads, Search Console</text>
      <text x="818" y="554" class="ga4flow__count" text-anchor="end" data-count="import">0</text>
    </g>

    <!-- destinations -->
    <g class="ga4flow__node" data-stage="reporting" tabindex="0" role="button" aria-label="Reporting">
      <rect x="880" y="40" width="304" height="96" />
