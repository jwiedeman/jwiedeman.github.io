      <text x="892" y="94" class="ga4flow__sub">Data API · Looker Studio</text>
      <text x="892" y="110" class="ga4flow__sub">Realtime (30 min) · DebugView</text>
      <text x="892" y="128" class="ga4flow__note">events reported <tspan class="ga4flow__count" data-count="reporting">0</tspan>  ·  realtime <tspan class="ga4flow__count" data-count="realtime">0</tspan></text>
    </g>
    <g class="ga4flow__node" data-stage="ads" tabindex="0" role="button" aria-label="Ad platforms">
      <rect x="880" y="170" width="304" height="76" />
      <text x="892" y="190" class="ga4flow__name">Ad platforms</text>
      <text x="892" y="208" class="ga4flow__sub">Google Ads · DV360 · SA360</text>
      <text x="892" y="224" class="ga4flow__sub">audiences + key events as conversions</text>
      <text x="1172" y="190" class="ga4flow__count" text-anchor="end" data-count="ads">0</text>
    </g>
    <g class="ga4flow__node" data-stage="bigquery" tabindex="0" role="button" aria-label="BigQuery export">
      <rect x="880" y="276" width="304" height="90" />
      <text x="892" y="296" class="ga4flow__name">BigQuery export</text>
      <text x="892" y="314" class="ga4flow__sub">events_intraday_ · streaming</text>
      <text x="892" y="330" class="ga4flow__sub">events_YYYYMMDD · daily</text>
      <text x="892" y="346" class="ga4flow__sub">pseudonymous_users_ · users_</text>
      <text x="1172" y="296" class="ga4flow__count" text-anchor="end" data-count="bigquery">0</text>
    </g>
    <g class="ga4flow__node" data-stage="warehouse" tabindex="0" role="button" aria-label="Warehouses and BI">
      <rect x="880" y="404" width="304" height="76" />
      <text x="892" y="424" class="ga4flow__name">Warehouses · BI</text>
      <text x="892" y="442" class="ga4flow__sub">Snowflake · Databricks · Redshift</text>
      <text x="892" y="458" class="ga4flow__sub">reverse ETL → CRM, ads</text>
      <text x="1172" y="424" class="ga4flow__count" text-anchor="end" data-count="warehouse">0</text>
    </g>

    <g data-packets></g>
  </svg>
  </div>

  <div class="ga4flow__explain" aria-live="polite">
    <strong data-explain-title>Click any box or processing step</strong>
    <p data-explain-body>Round dots are real gtag() calls from this page; squares are app batches and diamonds are TV or server hits (simulated). Follow one from its source to the warehouse. On a narrow screen, swipe the diagram sideways.</p>
  </div>

  <figcaption id="ga4flow-caption" class="ga4flow__legend">
    <span><i class="ga4flow__shape"></i> web hit</span>
    <span><i class="ga4flow__shape ga4flow__shape--sq"></i> app batch</span>
    <span><i class="ga4flow__shape ga4flow__shape--dia"></i> TV / server hit</span>
    <span><i class="ga4flow__shape ga4flow__shape--batch"></i> processed batch / export</span>
    <span><i class="ga4flow__dash"></i> realtime or optional path</span>
    <span>clock compressed: 1 s ≈ 1 h; a day closes every 24 s</span>
  </figcaption>
</figure>

<script define:vars={{ stages }}>
  window.__ga4FlowStages = stages;
</script>

<script>
  type Stage = { title: string; body: string };
  type Shape = 'circle' | 'square' | 'diamond' | 'batch';

  const SVGNS = 'http://www.w3.org/2000/svg';
  const SHAPES: Record<Shape, string> = {
    circle: 'M-4.5 0 a4.5 4.5 0 1 0 9 0 a4.5 4.5 0 1 0 -9 0',
    square: 'M-5 -5 h10 v10 h-10 z',
    diamond: 'M0 -6 L6 0 L0 6 L-6 0 z',
    batch: 'M-7 0 a7 7 0 1 0 14 0 a7 7 0 1 0 -14 0',
  };
  const MP_EVENTS = ['video_start', 'video_progress', 'video_complete', 'subscription_renewal', 'refund', 'channel_change'];

  function init(root: HTMLElement) {
    const stages = (window as unknown as { __ga4FlowStages: Record<string, Stage> }).__ga4FlowStages;
    const svg = root.querySelector<SVGSVGElement>('svg')!;
    const layer = root.querySelector<SVGGElement>('[data-packets]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const path = (id: string) => svg.querySelector<SVGPathElement>(`#${id}`)!;
    const counts: Record<string, number> = {};
    const PULSE_OF: Record<string, string> = { realtime: 'reporting', appq: 'app', queue: 'processing' };

    const setCount = (k: string, v: number) => {
      counts[k] = v;
      const el = root.querySelector(`[data-count="${k}"]`);
      if (el) el.textContent = String(v);
    };
    const pulse = (stage: string) => {
      const node = root.querySelector(`[data-stage="${stage}"]`);
      if (!node || reduce) return;
      node.classList.remove('is-pulse');
      void (node as SVGGElement).getBBox();
      node.classList.add('is-pulse');
    };
    const bump = (k: string, by = 1) => {
      setCount(k, (counts[k] ?? 0) + by);
      pulse(PULSE_OF[k] ?? k);
    };

    let paused = false;
    let viaSgtm = false;
    let auto = true;
    let queue = 0; // processed, not yet in standard reports
    let streamPending = 0; // waiting for the intraday export
    let appStored = 0; // events waiting on the device

    /** Move a shape along one or more paths; resolves at the end. */
    function travel(ids: string[], opts: { label?: string; shape?: Shape; speed?: number } = {}) {
      return new Promise<void>((resolve) => {
        if (reduce) return resolve();
        const g = document.createElementNS(SVGNS, 'g');
        const shape = opts.shape ?? 'circle';
        const mark = document.createElementNS(SVGNS, 'path');
        mark.setAttribute('d', SHAPES[shape]);
        mark.setAttribute('class', shape === 'batch' ? 'ga4flow__packet ga4flow__packet--batch' : 'ga4flow__packet');
        g.append(mark);
        if (opts.label) {
          const text = document.createElementNS(SVGNS, 'text');
          text.setAttribute('class', 'ga4flow__packet-label');
          text.setAttribute('x', '9');
          text.setAttribute('y', '-8');
          text.textContent = opts.label.length > 24 ? `${opts.label.slice(0, 23)}…` : opts.label;
          g.append(text);
        }
        layer.append(g);
        const segments = ids.map(path);
        const lengths = segments.map((p) => p.getTotalLength());
        const total = lengths.reduce((a, b) => a + b, 0);
        const speed = opts.speed ?? 0.3; // svg units per ms
        let travelled = 0;
        let last = performance.now();
        const step = (now: number) => {
          if (!paused) travelled += (now - last) * speed;
          last = now;
          let d = Math.min(travelled, total);
          let i = 0;
          while (i < segments.length - 1 && d > lengths[i]) d -= lengths[i++];
          const pt = segments[i].getPointAtLength(Math.min(d, lengths[i]));
          g.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
          if (travelled < total) requestAnimationFrame(step);
          else {
            g.remove();
            resolve();
          }
        };
        requestAnimationFrame(step);
      });
    }

    /** setTimeout that respects Pause. */
    const wait = (ms: number) =>
      new Promise<void>((r) => {
        let acc = 0;
        let last = performance.now();
        const iv = window.setInterval(() => {
          const now = performance.now();
          if (!paused) acc += now - last;
          last = now;
          if (acc >= ms) {
            window.clearInterval(iv);
            r();
          }
        }, 50);
      });

    /** Collection → processing, plus the realtime / DebugView fast path. */
    async function arrive(n: number, label: string, shape: Shape) {
      bump('collect', n);
      travel(['ga4p-realtime'], { speed: 0.6, shape }).then(() => bump('realtime', n));
      await travel(['ga4p-collect-proc'], { shape, label });
      queue += n;
      streamPending += n;
      setCount('queue', queue);
    }

    /** A real gtag() call from the page. */
    async function webHit(name: string, command: string) {
      if (command === 'event') {
        bump('ui');
        await travel(['ga4p-ui-dl'], { label: name });
      }
      bump('datalayer');
      if (command !== 'event' && command !== 'config') return; // js / consent commands stay in the browser
      await travel(['ga4p-dl-sdk'], { label: name });
      bump('sdk');
      await wait(120); // gtag.js batches briefly before sending
      if (viaSgtm) {
        await travel(['ga4p-sdk-sgtm'], { label: name });
        bump('sgtm');
        await wait(150);
        await travel(['ga4p-sgtm-collect'], { label: name });
      } else {
        await travel(['ga4p-sdk-collect'], { label: name });
      }
      await arrive(1, name, 'circle');
    }

    /** App events pile up on the device, then upload together. */
    function appEvent() {
      appStored += 1;
      bump('app');
      setCount('appq', appStored);
    }
    async function appUpload() {
      if (appStored === 0) appEvent();
      const n = appStored;
      appStored = 0;
      setCount('appq', 0);
      const label = `batch · ${n} event${n === 1 ? '' : 's'}`;
      await travel(['ga4p-app-collect'], { shape: 'square', label });
      await arrive(n, label, 'square');
    }

    async function mpHit(name = MP_EVENTS[Math.floor(Math.random() * MP_EVENTS.length)]) {
      bump('mp');
      await travel(['ga4p-mp-collect'], { shape: 'diamond', label: name });
      await arrive(1, name, 'diamond');
    }

    /** Light up each processing step in turn. */
    async function runSteps() {
      const steps = [...root.querySelectorAll<SVGGElement>('.ga4flow__step')];
      for (const s of steps) {
        s.classList.add('is-active');
        await wait(110);
        s.classList.remove('is-active');
      }
    }

    // Compressed clock: 1 s ≈ 1 h.
    let hours = 0;
    let day = 1;
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const meter = root.querySelector<SVGRectElement>('[data-meter]')!;
    let busy = false;
    window.setInterval(async () => {
      if (paused || busy) return;
      hours += 1;
      const h = hours % 24;
      meter.setAttribute('width', String((216 * h) / 24));
      clock.textContent = `day ${day} · ${String(h).padStart(2, '0')}:00`;

      if (auto) {
        if (Math.random() < 0.55) appEvent();
        if (h % 5 === 2) appUpload();
        if (h % 4 === 1) mpHit();
      }
      if (h === 6) {
        // Daily cost / CRM import lands in the property.
        travel(['ga4p-import-proc'], { shape: 'batch', label: 'cost + CRM import' }).then(() => bump('import'));
      }
      if (h % 3 === 0 && h !== 0 && streamPending > 0) {
        const n = streamPending;
        streamPending = 0;
        travel(['ga4p-proc-bq'], { label: `intraday +${n}`, speed: 0.4 });
      }
      if (h === 0) {
        day += 1;
        clock.textContent = `day ${day} · 00:00`;
        if (queue === 0) return;
        busy = true;
        const n = queue;
        queue = 0;
        setCount('queue', 0);
        streamPending = 0;
        await runSteps();
        await Promise.all([
          travel(['ga4p-proc-report'], { shape: 'batch', label: `${n} events · day ${day - 1}` }).then(() => bump('reporting', n)),
          travel(['ga4p-proc-ads'], { shape: 'batch', label: 'audiences · key events' }).then(() => bump('ads')),
          travel(['ga4p-proc-bq'], { shape: 'batch', label: `events_day${day - 1}` }).then(() => bump('bigquery', n)),
        ]);
        await travel(['ga4p-bq-wh'], { shape: 'batch', label: `load ${n} rows` });
        bump('warehouse', n);
        busy = false;
      }
    }, 1000);

    // Real hits from the page, plus anything gtag() queued before this script ran.
    window.addEventListener('ga4:hit', (e) => {
      const d = (e as CustomEvent<{ command: string; name: string }>).detail;
      webHit(d.name, d.command);
    });
    const early = (window as unknown as { dataLayer?: unknown[] }).dataLayer ?? [];
    early.forEach((args, i) => {
      const a = Array.from(args as ArrayLike<unknown>);
      const command = String(a[0] ?? '');
      window.setTimeout(() => webHit(command === 'event' ? String(a[1]) : command, command), 400 + i * 450);
    });

    // Controls.
    const btn = (action: string) => root.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!;
    btn('web').onclick = () => {
      const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      if (gtag) gtag('event', 'diagram_test_hit', { source: 'data_flow_diagram' });
      else webHit('diagram_test_hit', 'event');
    };
    btn('app').onclick = () => {
      const n = 2 + Math.floor(Math.random() * 4);
      for (let i = 0; i < n; i++) appEvent();
      appUpload();
    };
    btn('mp').onclick = () => mpHit();
    const toggle = (action: string, set: (on: boolean) => void, labels?: [string, string]) => {
      const b = btn(action);
      b.onclick = () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        if (labels) b.textContent = on ? labels[1] : labels[0];
        set(on);
      };
    };
    toggle('sgtm', (on) => {
      viaSgtm = on;
      root.classList.toggle('is-sgtm', on);
    });
    toggle('auto', (on) => (auto = on));
    toggle('pause', (on) => (paused = on), ['Pause', 'Resume']);

    // Explanations.
    const title = root.querySelector<HTMLElement>('[data-explain-title]')!;
    const body = root.querySelector<HTMLElement>('[data-explain-body]')!;
    root.querySelectorAll<SVGGElement>('[data-stage]').forEach((node) => {
      const show = (e: Event) => {
        e.stopPropagation();
        const s = stages[node.dataset.stage!];
        if (!s) return;
        root.querySelectorAll('.is-selected').forEach((n) => n.classList.remove('is-selected'));
        node.classList.add('is-selected');
        title.textContent = s.title;
        body.textContent = s.body;
      };
      node.addEventListener('click', show);
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          show(e);
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-ga4flow]').forEach(init);
</script>

