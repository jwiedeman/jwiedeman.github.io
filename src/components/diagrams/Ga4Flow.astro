    <path id="ga4p-dl-sdk" d="M158 168 L158 192" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-sdk-collect" d="M284 230 C 318 230, 318 290, 350 290" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-sdk-sgtm" d="M284 210 C 318 210, 318 168, 350 168" class="ga4flow__link ga4flow__link--dashed" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-sgtm-collect" d="M430 206 L430 250" class="ga4flow__link ga4flow__link--dashed" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-app-collect" d="M284 384 C 318 384, 318 360, 350 360" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-mp-collect" d="M284 534 C 318 534, 318 430, 350 430" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-collect-proc" d="M540 340 L590 340" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
