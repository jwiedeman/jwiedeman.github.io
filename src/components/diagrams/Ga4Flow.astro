    <text x="16" y="16" class="ga4flow__col">1 · SOURCES</text>
    <text x="350" y="16" class="ga4flow__col">2 · COLLECTION</text>
    <text x="590" y="16" class="ga4flow__col">3 · GA4 PROPERTY</text>
    <text x="880" y="16" class="ga4flow__col">4 · DESTINATIONS</text>

    <!-- source frames -->
    <rect x="16" y="28" width="284" height="262" class="ga4flow__frame" />
