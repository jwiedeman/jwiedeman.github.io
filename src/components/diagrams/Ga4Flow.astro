    <text x="28" y="280" class="ga4flow__note">cookies: _ga (client id) · _ga_&lt;ID&gt; (session)</text>
    <rect x="16" y="302" width="284" height="138" class="ga4flow__frame" />
    <text x="28" y="320" class="ga4flow__label">APP · iOS / ANDROID</text>
    <rect x="16" y="452" width="284" height="138" class="ga4flow__frame" />
    <text x="28" y="470" class="ga4flow__label">TV · OTT · SERVER</text>

    <!-- links (under nodes) -->
