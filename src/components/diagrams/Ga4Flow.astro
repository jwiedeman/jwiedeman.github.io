    <path id="ga4p-import-proc" d="M710 534 L710 504" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-proc-report" d="M830 150 C 856 150, 856 110, 880 110" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-proc-ads" d="M830 250 C 856 250, 856 214, 880 214" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-proc-bq" d="M830 360 C 856 360, 856 318, 880 318" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <path id="ga4p-bq-wh" d="M1032 366 L1032 404" class="ga4flow__link" marker-end="url(#ga4flow-arrow)" />
    <text x="600" y="62" class="ga4flow__note">realtime · DebugView · seconds</text>
    <text x="304" y="262" class="ga4flow__note">HTTPS</text>

