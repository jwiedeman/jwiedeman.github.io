---
const links = [
  { label: 'Work', href: '/work' },
  { label: 'Lab', href: '/lab' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// Greyscale ramp that trails off the color swatches
const greys = ['#3a3a3a', '#4a4a4a', '#5c5c5c', '#707070', '#868686', '#9c9c9c', '#b4b4b4', '#cccccc', '#e4e4e4'];
---
<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__brand" data-astro-prefetch>Joshua Franklin Wiedeman</a>
    <div class="swatches" aria-hidden="true">
      <span style="background: var(--swatch-1)"></span>
      <span style="background: var(--swatch-2)"></span>
      <span style="background: var(--swatch-3)"></span>
      <span style="background: var(--swatch-4)"></span>
      <span style="background: var(--swatch-5)"></span>
      <span style="background: var(--swatch-6)"></span>
      <i></i>
      {greys.map((g) => <span style={`background: ${g}`}></span>)}
    </div>
  </div>
  <nav class="site-header__nav" aria-label="Primary">
    {links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined} data-astro-prefetch>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    padding: var(--space-2) var(--page-inline) 0;
    max-width: 72rem;
    width: 100%;
    margin: 0 auto;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .site-header__brand {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-14);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .swatches {
    display: flex;
    gap: 2px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
  }

  .swatches span {
    width: 0.875rem;
    height: 0.625rem;
    flex-shrink: 0;
  }

  .swatches i {
    width: 0.75rem;
    flex-shrink: 0;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-1) 0;
    margin-top: var(--space-1);
    border-bottom: 1px solid var(--color-rule);
  }

  .site-header__nav a {
    font-size: var(--text-12);
    color: var(--color-muted);
    text-decoration: none;
    padding: 0 0.25em;
    margin-left: -0.25em;
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current='page']::before {
    content: '\25A0\00a0';
  }

  .site-header__nav a:hover {
    color: var(--color-bg);
  }

  @media (max-width: 640px) {
    .swatches span:nth-child(n + 8) {
      display: none;
    }

    .swatches i {
      display: none;
    }
  }
</style>
